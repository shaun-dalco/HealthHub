<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nutrition Log"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="@android:color/white"
        android:paddingBottom="10dp"/>

    <!-- Form Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="14dp">

        <EditText
            android:id="@+id/etDay"
            style="@style/AppInput"
            android:hint="Day (YYYY-MM-DD)"
            android:inputType="text"
            android:drawableStart="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="10dp"/>

        <Spinner
            android:id="@+id/spMealType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

        <EditText
            android:id="@+id/etName"
            style="@style/AppInput"
            android:layout_marginTop="10dp"
            android:hint="Food name"
            android:inputType="textPersonName"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="10dp"/>

        <!-- Macros row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/etCalories"
                style="@style/AppInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Calories"
                android:inputType="numberDecimal"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:drawablePadding="10dp"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <EditText
                android:id="@+id/etProtein"
                style="@style/AppInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Protein"
                android:inputType="numberDecimal"
                android:drawableStart="@android:drawable/ic_menu_manage"
                android:drawablePadding="10dp"/>
        </LinearLayout>

        <!-- Macros row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/etCarbs"
                style="@style/AppInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Carbs"
                android:inputType="numberDecimal"
                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="10dp"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <EditText
                android:id="@+id/etFats"
                style="@style/AppInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Fats"
                android:inputType="numberDecimal"
                android:drawableStart="@android:drawable/ic_menu_compass"
                android:drawablePadding="10dp"/>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Add"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_btn_primary"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Clear"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_btn_danger"/>
        </LinearLayout>

        <!-- Status chip -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ready"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_chip"/>
    </LinearLayout>

    <!-- List container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:padding="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>
    </LinearLayout>

</LinearLayout>
